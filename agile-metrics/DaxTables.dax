//Create dimDate table using DAX
dimDate = ADDCOLUMNS (
    CALENDAR (DATE(2026, 1, 1), DATE(2026, 12, 31)),
    "DateSk", YEAR([Date]) * 10000 + MONTH ([Date]) * 100 + DAY ([Date]),
    "Year", YEAR ([DATE]),
    "MonthNum", MONTH ([DATE]),
    "MonthSort", YEAR([DATE]) * 100 + MONTH([DATE]),
    "Month", FORMAT ([Date], "MMM yyyy)"),
    "WeekStart", [Date] - WEEKDAY([Date], 2) +1,
    "Week", "Wk of " & FORMAT([DATE] - WEEKDAY ([DATE], 2) + 1, "MMM d")  
)